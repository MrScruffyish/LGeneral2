# Top-level build entry point (the generic rule above would ignore it)
!/Makefile
.build/

# Generated autotools files. The build bootstraps these in .build/ with
# autoreconf -fi, so they are intentionally not tracked in git.
configure
aclocal.m4
config.h.in
Makefile.in
Makefile.in.in
stamp-h.in
compile
config.guess
config.sub
config.rpath
depcomp
install-sh
missing
mkinstalldirs
INSTALL

